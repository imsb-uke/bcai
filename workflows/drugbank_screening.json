{
  "name": "drugbank_screening",
  "description": "Prepare protein (files/esm3_seq.pdb), prepare DrugBank sample of 20 ligands, run smina screening (exhaustiveness 16).",
  "created_at": "2026-05-31T13:54:16.156557",
  "steps": [
    {
      "id": "step1",
      "tool": "prepare_protein",
      "args": {
        "pdb_file": "files/esm3_seq.pdb",
        "protein_name": "esm3_seq",
        "project_name": "drugbank_screening",
        "docking_method": "smina"
      }
    },
    {
      "id": "step2",
      "tool": "prepare_library",
      "args": {
        "source_csv": "files/drugbank.csv",
        "library_dir": "files/drugbank_20",
        "n_sample": 20,
        "ph": 7.4
      }
    },
    {
      "id": "step3",
      "tool": "run_virtual_screening",
      "args": {
        "protein_df_file": "${step1.protein_df_file}",
        "library_dir": "${step2.library_dir}",
        "project_name": "drugbank_screening",
        "docking_method": "smina",
        "exhaustiveness": "16"
      }
    }
  ]
}