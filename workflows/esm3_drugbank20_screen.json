{
  "name": "esm3_drugbank20_screen",
  "description": "Prepare protein from files/esm3_seq.pdb; prepare DrugBank library (sample 20 ligands); run screening with smina (exhaustiveness 16).",
  "created_at": "2026-05-31T14:28:06.393953",
  "steps": [
    {
      "id": "step1",
      "tool": "prepare_protein",
      "args": {
        "pdb_file": "files/esm3_seq.pdb",
        "protein_name": "esm3_seq",
        "project_name": "esm3_drugbank20_screen",
        "docking_method": "smina"
      }
    },
    {
      "id": "step2",
      "tool": "prepare_library",
      "args": {
        "source": "drugbank",
        "library_name": "drugbank20",
        "n_sample": 20,
        "ph": 7.4
      }
    },
    {
      "id": "step3",
      "tool": "run_virtual_screening",
      "args": {
        "protein_df_file": "${step1.protein_df_file}",
        "library_name": "${step2.library_name}",
        "project_name": "esm3_drugbank20_screen",
        "docking_method": "smina",
        "exhaustiveness": "16"
      }
    }
  ]
}