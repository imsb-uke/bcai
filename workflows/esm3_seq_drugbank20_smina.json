{
  "name": "esm3_seq_drugbank20_smina",
  "description": "Prepare protein from files/esm3_seq.pdb, prepare a 20-compound DrugBank library, screen with smina, and return top hits.",
  "created_at": "2026-05-31T12:49:58.385363",
  "steps": [
    {
      "id": "step1",
      "tool": "prepare_protein",
      "args": {
        "pdb_file": "files/esm3_seq.pdb",
        "protein_name": "esm3_seq",
        "project_name": "esm3_seq_drugbank20_smina",
        "docking_method": "smina",
        "partial_charge": "gasteiger"
      }
    },
    {
      "id": "step2",
      "tool": "prepare_library",
      "args": {
        "source": "drugbank",
        "library_name": "drugbank20",
        "n_sample": 20,
        "ph": 7.4
      }
    },
    {
      "id": "step3",
      "tool": "run_screening",
      "args": {
        "protein_df_file": "${step1.protein_df_file}",
        "library_name": "drugbank20",
        "project_name": "esm3_seq_drugbank20_smina",
        "docking_method": "smina",
        "exhaustiveness": "16",
        "file_dir": "files"
      }
    },
    {
      "id": "step4",
      "tool": "get_top_hits",
      "args": {
        "project_name": "esm3_seq_drugbank20_smina",
        "docking_method": "smina",
        "top_n": 20,
        "file_dir": "files"
      }
    }
  ]
}